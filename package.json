{
  "name": "slide-charts",
  "version": "0.3.0",
  "description": "Consulting-style charts for PowerPoint (Office add-in).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "tsc && vite build && node scripts/build-manifest.mjs",
    "preview": "node scripts/preview.mjs",
    "e2e": "npm run build && node test/e2e/run.mjs",
    "gallery": "esbuild scripts/gallery.ts --bundle --platform=node --format=esm --outfile=gallery.mjs && node gallery.mjs gallery.html"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/office-js": "^1.0.617",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
